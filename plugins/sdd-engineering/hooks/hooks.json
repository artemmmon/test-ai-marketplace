{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Agent|Task|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/spec-creator-guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plans-guard.mjs\" --kind plan",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/plans-guard.mjs\" --kind brainstorm",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/run-check-hook.mjs\" sdd-engineering:spec-creator skills/spec-authoring/assets/check-spec.mjs --hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/run-check-hook.mjs\" sdd-engineering:implementation-planner skills/run-plan/assets/check-plan.mjs --hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
